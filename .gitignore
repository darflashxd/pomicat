# ==============================================================================
# PomiCat: Production .gitignore
# ==============================================================================

# 1. AI tooling: knowledge graphs (graphify) and Claude / agent config (never commit)
node_modules/
.env
.env.*
!.env.example
!.env.sample
graphify-out/
**/graphify-out/
.graphify*
**/.graphify*
.claude/
CLAUDE.md
CLAUDE.local.md
.playwright-mcp/

# 2. Python Environments & Caches
venv/
.venv/
env/
**/venv/
**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# 3. Model Weights & Large Checkpoints (>100MB violates GitHub limits)
# Model weights are not in git (see MODELS_SETUP.md)
*.onnx
!extension/models/*.onnx
*.safetensors
*.pt
*.pth
*.bin
**/checkpoint-*/
**/model_output/checkpoint-*/
**/model_output/best_model/
**/model_output/minilm_q4/
**/model.safetensors
**/optimizer.pt
**/safeshare_model.zip

# 4. External Precompiled Binaries
cloudflared
**/cloudflared

# 5. Local Databases, State & Cloudflare Wrangler Cache
.wrangler/
**/.wrangler/
storage.json
**/storage.json
*.db
*.sqlite
*.sqlite3
*.sqlite-*

# 6. Test Reports & Logs
*.log
npm-debug.log*
yarn-debug.log*

# 7. OS & Editor Metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
.opencode/
*.swp
*.swo
ide_keighton.txt

# 8. Generated data and build outputs
# Regenerate with: python data/generate_dataset.py (seeded, byte-identical output)
data/train.json
data/val.json
data/test.json
data/cli_hardneg_eval.json
data/cli_hardneg_gold.jsonl
data/benchmarks/
# Extension builds go to GitHub Releases, not git
*.zip
*.xpi
.venv-*/
tools/eval/data/
# SOTA benchmark: model zoo + raw results (regenerate with tools/sota/fetch_models.py)
training/model_zoo/
tools/sota/results_raw/
# 16 MB XLM-R tokenizer blob (re-fetch from HF id in model_card.json instead)
training/model_output/mminilmv2-sota/tokenizer.json
training/model_output/mminilmv2-smoke/

