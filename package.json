{
  "name": "safeshare-ai",
  "version": "2.3.0",
  "description": "Redacts sensitive data from AI chat transcripts, blocks algebraic recovery of redacted numbers, and shares the result as an end-to-end encrypted link.",
  "main": "bin/safeshare.js",
  "bin": {
    "safeshare": "bin/safeshare.js"
  },
  "files": [
    "bin/",
    "extension/engine/heuristics.js",
    "extension/engine/contextual.js",
    "extension/engine/pseudonymizer.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node tests/run_all.js",
    "benchmark": "node tools/benchmark_comparative.js",
    "relay:local": "python relay/server_local.py",
    "demo": "node bin/safeshare.js invert examples/chat_naive_redacted.txt"
  },
  "keywords": [
    "privacy",
    "aes-gcm",
    "llm-security",
    "blackhat-arsenal",
    "contextual-integrity",
    "data-redaction",
    "algebraic-reconstruction",
    "chrome-extension",
    "firefox-addon",
    "e2e-encryption"
  ],
  "author": "SafeShare-AI contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/darflashxd/safeshare.git"
  }
}
