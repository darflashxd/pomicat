{
  "name": "pomicat",
  "version": "3.0.2",
  "description": "PomiCat reviews and redacts AI chats and Word documents before encrypted sharing.",
  "main": "bin/pomicat.js",
  "bin": {
    "pomicat": "bin/pomicat.js"
  },
  "files": [
    "bin/",
    "extension/engine/heuristics.js",
    "extension/engine/contextual.js",
    "extension/engine/pseudonymizer.js",
    "extension/engine/policy.js",
    "extension/engine/crypto.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node tests/run_all.js",
    "relay:local": "python relay/server_local.py",
    "demo": "node bin/pomicat.js invert examples/chat_naive_redacted.txt"
  },
  "keywords": [
    "privacy",
    "aes-gcm",
    "llm-security",
    "contextual-integrity",
    "data-redaction",
    "algebraic-reconstruction",
    "chrome-extension",
    "firefox-addon",
    "e2e-encryption"
  ],
  "author": "PomiCat contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/darflashxd/pomicat.git"
  }
}
