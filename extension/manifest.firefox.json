{
  "manifest_version": 3,
  "name": "SafeShare-AI Privacy Guard",
  "version": "2.4.0",
  "description": "Redacts sensitive data from AI chats before sharing and creates end-to-end encrypted, expiring share links. Works on ChatGPT, Claude and DeepSeek.",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://chat.deepseek.com/*",
    "https://safeshare-relay.bleedguard.workers.dev/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": [
      "models/ort.min.js",
      "engine/wordpiece.js",
      "offscreen.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://safeshare-relay.bleedguard.workers.dev/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "viewer_redirect.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://chat.deepseek.com/*",
        "https://safeshare-relay.bleedguard.workers.dev/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "css": [
        "ui/modal.css"
      ],
      "js": [
        "engine/span_arbiter.js",
        "engine/heuristics.js",
        "engine/contextual.js",
        "engine/maybe.js",
        "engine/ner_client.js",
        "engine/transcript.js",
        "engine/pseudonymizer.js",
        "engine/policy.js",
        "engine/crypto.js",
        "engine/symbolic_vault.js",
        "engine/symbolic_rewriter.js",
        "engine/local_compute.js",
        "ui/modal.js",
        "content_script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "safeshare@research.local",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "action": {
    "default_title": "SafeShare-AI Privacy Guard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://safeshare-relay.bleedguard.workers.dev http://localhost:* http://127.0.0.1:*; object-src 'none';"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
