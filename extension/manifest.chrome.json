{
  "manifest_version": 3,
  "name": "SafeShare-AI Privacy Guard",
  "version": "2.3.1",
  "description": "Redacts sensitive data from AI chats before sharing and creates end-to-end encrypted, expiring share links. Works on ChatGPT, Claude and DeepSeek.",
  "permissions": [
    "storage",
    "clipboardWrite",
    "offscreen"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://chat.deepseek.com/*",
    "https://*.workers.dev/*",
    "https://*.pages.dev/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://chat.deepseek.com/*",
        "https://*.workers.dev/*",
        "https://*.pages.dev/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "css": [
        "ui/modal.css"
      ],
      "js": [
        "engine/span_arbiter.js",
        "engine/heuristics.js",
        "engine/contextual.js",
        "engine/pseudonymizer.js",
        "engine/policy.js",
        "engine/crypto.js",
        "engine/symbolic_vault.js",
        "engine/symbolic_rewriter.js",
        "engine/local_compute.js",
        "ui/modal.js",
        "content_script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "SafeShare-AI Privacy Guard"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "models/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'; object-src 'none';"
  }
}
