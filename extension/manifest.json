{
  "manifest_version": 3,
  "name": "PomiCat",
  "version": "3.0.1",
  "description": "Review and redact sensitive data in AI chats and Word documents, then share a sanitized copy as an encrypted link.",
  "permissions": [
    "storage",
    "clipboardWrite",
    "offscreen",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://chat.deepseek.com/*",
    "https://gemini.google.com/*",
    "https://safeshare-relay.bleedguard.workers.dev/*",
    "https://blackline-relay.bleedguard.workers.dev/*",
    "https://pomicat-relay.bleedguard.workers.dev/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.sharepoint.com/*",
    "https://*.officeapps.live.com/*",
    "https://word.cloud.microsoft/*",
    "https://docs.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://safeshare-relay.bleedguard.workers.dev/*",
        "https://blackline-relay.bleedguard.workers.dev/*",
        "https://pomicat-relay.bleedguard.workers.dev/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "relay_hosts.js",
        "viewer/redirect_logic.js",
        "viewer_redirect.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://chat.deepseek.com/*",
        "https://gemini.google.com/*",
        "https://safeshare-relay.bleedguard.workers.dev/*",
        "https://blackline-relay.bleedguard.workers.dev/*",
        "https://pomicat-relay.bleedguard.workers.dev/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "css": [
        "ui/modal.css"
      ],
      "js": [
        "engine/span_arbiter.js",
        "engine/heuristics.js",
        "engine/contextual.js",
        "engine/maybe.js",
        "engine/ner_client.js",
        "engine/transcript.js",
        "engine/pseudonymizer.js",
        "engine/policy.js",
        "engine/crypto.js",
        "engine/chat_id.js",
        "engine/symbolic_vault.js",
        "engine/symbolic_rewriter.js",
        "engine/local_compute.js",
        "engine/settings.js",
        "ui/brand-assets.js",
        "ui/modal.js",
        "content_script.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.sharepoint.com/*",
        "https://*.officeapps.live.com/*",
        "https://word.cloud.microsoft/*",
        "https://docs.google.com/document/*"
      ],
      "js": [
        "ui/brand-assets.js",
        "word/launcher.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "PomiCat",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://pomicat-relay.bleedguard.workers.dev https://safeshare-relay.bleedguard.workers.dev https://blackline-relay.bleedguard.workers.dev http://localhost:* http://127.0.0.1:*; object-src 'none';"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
